---
import { Image } from 'astro:assets';
import portrait from '../assets/reid-marlow.jpg';
import { AUTHOR, SITE_DESCRIPTION } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="About / Reid Marlow"
	description="Reid Marlow - a technologist working in automation. Small sharp tools, AI agents, and the boring plumbing that makes them work."
	image={portrait}
>
	<div class="wrap">
		<section class="hero">
			<div class="about-hero-grid">
				<figure class="portrait-card">
					<Image
						src={portrait}
						alt={`${AUTHOR.name} at a desk with a notebook and laptop`}
						widths={[320, 480, 640, 960]}
						sizes="(max-width: 860px) 88vw, 360px"
						quality={84}
						loading="eager"
						fetchpriority="high"
					/>
					<figcaption class="portrait-meta">
						<span class="status">reid@home</span>
						<span class="loc">desk · notebook · build</span>
					</figcaption>
				</figure>
				<div>
					<div class="prompt"><span class="g">$</span> cat about.md</div>
					<h1 class="page-title">whoami</h1>
					<p class="page-sub">{SITE_DESCRIPTION}</p>
					<div class="about-card" style="margin-top: 24px;">
						<dl>
							<dt>name</dt>
							<dd>{AUTHOR.name}</dd>
							<dt>born</dt>
							<dd>{AUTHOR.born}</dd>
							<dt>edu</dt>
							<dd>{AUTHOR.edu}</dd>
							<dt>pronouns</dt>
							<dd>{AUTHOR.pronouns}</dd>
						</dl>
					</div>
				</div>
			</div>
		</section>

		<article class="prose" style="padding:34px 0 8px;">
			<p>{AUTHOR.bio}</p>
			<p>
				Most of what I do lives at the unglamorous layer: parsing messy inputs, wiring
				retries, and trusting an agent&apos;s output enough to stop babysitting it. The loop was
				never the hard part. I write here about the things that actually shipped, the ones
				that quietly died, and the habits that survived contact with production.
			</p>

			<h2>What you&apos;ll find here</h2>
			<ul>
				<li><b>Build logs</b> - small command-line tools and the decisions behind them.</li>
				<li><b>Agents, honestly</b> - what works and what is only a for-loop with polish.</li>
				<li><b>Plumbing</b> - parsing, retries, queues, cron, and the boring 80% nobody demos.</li>
			</ul>
		</article>

		<section class="blk about" id="newsletter" style="border-bottom:none;padding-top:10px;">
			<div class="sec-head"><h2>Newsletter</h2></div>
			<p class="dim">
				Occasional notes from this field notebook — when there's something worth saying.
			</p>
			<form id="newsletter-form" class="newsletter-form">
				<label for="newsletter-email" class="skip">Email</label>
				<input
					id="newsletter-email"
					name="email"
					type="email"
					inputmode="email"
					autocomplete="email"
					spellcheck="false"
					placeholder="you@example.com"
					required
				/>
				<input name="website" class="skip" tabindex="-1" autocomplete="off" value="" />
				<button class="btn primary" type="submit" id="newsletter-btn">Subscribe</button>
			</form>
			<p class="dim" id="newsletter-msg">Occasional notes. Unsubscribe anytime.</p>
			<script is:inline>
				(function () {
					var form = document.getElementById('newsletter-form');
					if (!form) return;
					var btn = document.getElementById('newsletter-btn');
					var msg = document.getElementById('newsletter-msg');
					form.addEventListener('submit', function (e) {
						e.preventDefault();
						var email = (form.email && form.email.value || '').trim();
						if (!email) return;
						btn.disabled = true;
						msg.textContent = 'Subscribing…';
						fetch('https://mail.komoai.net:8443/api/subscribe', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({
								email: email,
								blog: 'reid',
								website: form.website ? form.website.value : '',
							}),
						})
							.then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
							.then(function (x) {
								if (x.ok && x.j && x.j.ok) {
									msg.textContent = "You're in. Thanks — no confirmation email needed.";
									form.reset();
								} else {
									msg.textContent = 'Could not subscribe. Check the address and try again.';
									btn.disabled = false;
								}
							})
							.catch(function () {
								msg.textContent = 'Network error. Try again in a moment.';
								btn.disabled = false;
							});
					});
				})();
			</script>
		</section>

	</div>
</BaseLayout>
