---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import portrait from '../assets/reid-marlow.jpg';
import FormattedDate from '../components/FormattedDate.astro';
import { AUTHOR, PRINCIPLES, QUOTE, SITE_DESCRIPTION, SITE_TITLE, TOOLS } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featured, ...rest] = posts;
const recent = rest.slice(0, 5);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} image={portrait}>
	<div class="wrap">
		<section class="hero">
			<div class="hero-grid">
				<div class="hero-copy">
					<div class="prompt"><span class="g">$</span> whoami<span class="cursor" aria-hidden="true"></span></div>
					<h1>Reid Marlow&apos;s personal space</h1>
					<p class="sub">&ldquo;{QUOTE}&rdquo;</p>
					<div class="cta">
						<a class="btn primary" href="/blog">Read the blog</a>
						<a class="btn" href="/about">About me</a>
						<a class="btn" href="/about#newsletter">Subscribe</a>
					</div>
					<div class="hero-note" aria-label="Topics">
						<span>automation</span>
						<span>AI agents</span>
						<span>small tools</span>
					</div>
				</div>

				<aside class="hero-panel" aria-label="Portrait and notes">
					<div class="panel-inner">
						<div class="panel-top">
							<div class="lights" aria-hidden="true"><span></span><span></span><span></span></div>
							<span>reid@home:~/notes</span>
						</div>
						<div class="terminal-lines">
							<div><span class="g">$</span> cat principles.txt</div>
							<div class="cmd principle-quote">&ldquo;{PRINCIPLES}&rdquo;</div>
						</div>
						<figure class="hero-shot">
							<Image
								src={portrait}
								alt={`${AUTHOR.name} at a desk with a notebook and laptop`}
								widths={[320, 480, 640, 960]}
								sizes="(max-width: 860px) 90vw, 360px"
								quality={82}
								loading="eager"
								fetchpriority="high"
							/>
							<figcaption class="hero-shot-cap">~/portrait · field notes</figcaption>
						</figure>
					</div>
				</aside>
			</div>
		</section>

		<section class="blk about" id="about">
			<div class="sec-head"><h2>whoami</h2></div>
			<div class="identity-grid with-portrait">
				<div>
					<p>{AUTHOR.bio}</p>
					<p class="dim">
						This is a field notebook for the unglamorous layer: parsing messy inputs, wiring
						retries, and deciding which agent workflows are worth keeping.
					</p>
				</div>
				<figure class="portrait-card">
					<Image
						src={portrait}
						alt={`${AUTHOR.name}, portrait`}
						widths={[320, 480, 640]}
						sizes="(max-width: 860px) 70vw, 260px"
						quality={80}
						loading="lazy"
					/>
					<figcaption class="portrait-meta">
						<span class="status">online</span>
						<span class="loc">hk · field desk</span>
					</figcaption>
				</figure>
				<div class="about-card">
					<dl>
						<dt>born</dt>
						<dd>{AUTHOR.born}</dd>
						<dt>edu</dt>
						<dd>{AUTHOR.edu}</dd>
						<dt>pronouns</dt>
						<dd>{AUTHOR.pronouns}</dd>
						<dt>mode</dt>
						<dd>field notes</dd>
					</dl>
				</div>
			</div>
		</section>

		<section class="blk" id="featured">
			<div class="sec-head"><h2>Latest</h2></div>
			{
				featured ? (
					<a class="feature" href={`/${featured.id}/`}>
						<div class="kicker">latest post</div>
						<h3>{featured.data.title}</h3>
						<p>{featured.data.description}</p>
						<div class="meta">
							<FormattedDate date={featured.data.pubDate} />
						</div>
					</a>
				) : (
					<div class="empty">
						<h3>The blog is staged but the first post has not shipped.</h3>
						<p>
							The design treats an empty archive as a valid state: quiet, intentional, and ready
							for the first build log.
						</p>
						<pre><span class="g">$</span> ls src/content/blog/
.gitkeep</pre>
						<div class="empty-actions">
							<a class="btn primary" href="/about">Read the short version</a>
							<a class="btn" href="/blog">Open archive</a>
						</div>
					</div>
				)
			}
		</section>

		<section class="blk" id="posts">
			<div class="sec-head">
				<h2>Blog</h2>
				{recent.length > 0 && <a href="/blog">archive -&gt;</a>}
			</div>
			{
				recent.length > 0 ? (
					<div class="post-list">
						{recent.map((post) => (
							<a class="post" href={`/${post.id}/`}>
								<div class="top">
									<h3>{post.data.title}</h3>
									<span class="date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</div>
								<p>{post.data.description}</p>
							</a>
						))}
					</div>
				) : (
					<div class="topics" aria-label="Planned topics">
						<a class="topic" href="/blog">
							<h3>Build logs</h3>
							<p>Small command-line tools and the decisions behind them.</p>
						</a>
						<a class="topic" href="/blog">
							<h3>Agents, honestly</h3>
							<p>What works, what breaks, and what is just a loop with better manners.</p>
						</a>
						<a class="topic" href="/blog">
							<h3>Plumbing</h3>
							<p>Parsing, retries, queues, cron, and the boring 80% nobody demos.</p>
						</a>
					</div>
				)
			}
		</section>

		<section class="blk" id="tools">
			<div class="sec-head"><h2>Tools</h2></div>
			<p style="max-width:62ch;margin:0 0 22px;color:var(--muted);font-size:0.97rem;">
				KolmoPDF is the daily driver; the rest are useful adjacent picks.
			</p>
			<div class="tools-stack">
				{
					TOOLS.map((tool, i) =>
						i === 0 ? (
							<a class="feature" href={tool.href} target="_blank" rel="noopener">
								<div class="kicker">utility / {tool.kicker}</div>
								<h3>{tool.name}</h3>
								<p>{tool.longBlurb ?? tool.blurb}</p>
								<div class="meta">{tool.host} -&gt;</div>
							</a>
						) : (
							<a class="tool-rec tools-secondary" href={tool.href} target="_blank" rel="noopener">
								<div class="tool-rec-top">
									<span class="tool-name">{tool.name}</span>
									<span class="tool-tag">{tool.kicker}</span>
								</div>
								<p>{tool.longBlurb ?? tool.blurb}</p>
								<span class="tool-link">{tool.host} -&gt;</span>
							</a>
						),
					)
				}
			</div>
		</section>
	</div>
</BaseLayout>
