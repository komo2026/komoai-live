---
import { SOCIAL_LINKS } from '../consts';
import { SOCIAL_ICONS } from '../social-icons';
const year = new Date().getFullYear();
---

<footer class="site">
	<div class="wrap">
		<div class="foot">
			<div class="brand">
				<span class="brand-mark" aria-hidden="true">R</span>
				<span>Reid Marlow</span>
			</div>
			<nav class="socials" aria-label="Elsewhere">
				{
					SOCIAL_LINKS.map((s) => {
						const icon = s.icon ? SOCIAL_ICONS[s.icon as keyof typeof SOCIAL_ICONS] : null;
						return (
							<a class="social-link mono" href={s.href} target="_blank" rel="me noopener" title={s.label}>
								{icon ? <span class="social-icon" set:html={icon.svg} /> : null}
								<span class="social-label">{s.label}</span>
							</a>
						);
					})
				}
			</nav>
		</div>
		<div class="colophon">&copy; {year} Reid Marlow / personal space / built with Astro</div>
	</div>
</footer>
