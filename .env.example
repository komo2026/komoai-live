# Reid Marlow personal blog — build-time environment (Hashnode headless CMS)
# Copy to .env for local builds. On Vercel, set these as Project env vars
# (Production + Preview). On the laptop these live in secrets.env.
#
# Hashnode Personal Access Token (Pro). Used as `Authorization: Bearer <token>`.
# GraphQL read access is Pro-gated, so this is required to pull content.
HASHNODE_TOKEN=

# Preferred: stable publication id (survives public domain renames).
HASHNODE_PUBLICATION_ID=6a3737852246260d59ba0b51

# Hashnode host metadata for GraphQL lookup when id is unset.
# This is CMS metadata — NOT the public site domain. Public site is reidmarlow.com.
# Hashnode headless custom domain is reidmarlow.com.
HASHNODE_PUBLICATION_HOST=reidmarlow.com
